APP_NAME=Sanduq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanduq
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد — تُستخدم لإرسال رمز استعادة كلمة المرور (٦ خانات).
#
# القيمة الافتراضية log تعمل فورًا بلا أي إعداد: بدل إرسال الرسالة تُكتب
# كاملةً في storage/logs/laravel.log، ويمكن قراءة الرمز منها لتجربة التدفق.
# هذا كافٍ لتشغيل المشروع ومراجعته.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# لإرسال بريد حقيقي عبر Gmail، استبدل ما فوق بالقيم التالية وضع
# "كلمة مرور تطبيق" (App Password) من حساب Google الخاص بك — لا كلمة مرور
# الحساب نفسها، فهي مرفوضة. تُولَّد من: myaccount.google.com/apppasswords
# (تتطلب تفعيل التحقق بخطوتين أولًا)، وتُلصق بلا مسافات.
#
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-address@gmail.com
# MAIL_PASSWORD=your16charapppassword
# MAIL_FROM_ADDRESS="your-address@gmail.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
